{
  "name": "namaz-tracker",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zoyaimran2005/namaz-tracker-desktop-app.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder"
  },
  "build": {
    "appId": "com.namaztracker.app",
    "productName": "Namaz Tracker",
    "files": [
      "**/*"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": ["dmg", "zip"],
      "icon": "assets/icons8-moon-100.icns"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icons8-moon-100.ico"
    },
    "linux": {
      "icon": "assets/icons8-moon-100.png"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  }
}